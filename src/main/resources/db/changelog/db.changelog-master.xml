<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <changeSet id="20261009-report-periodic-reports" author="minhdat">
        <createTable tableName="periodic_reports">
            <column name="report_id" type="UUID"><constraints primaryKey="true" nullable="false"/></column>
            <column name="owner_id" type="UUID"><constraints nullable="false"/></column>
            <column name="period_type" type="VARCHAR(20)"><constraints nullable="false"/></column>
            <column name="period_start" type="DATE"><constraints nullable="false"/></column>
            <column name="period_end" type="DATE"><constraints nullable="false"/></column>
            <column name="total_revenue" type="NUMERIC(19,2)"><constraints nullable="false"/></column>
            <column name="booking_count" type="BIGINT"><constraints nullable="false"/></column>
            <column name="paid_booking_count" type="BIGINT"><constraints nullable="false"/></column>
            <column name="revenue_change_percentage" type="NUMERIC(10,2)"/>
            <column name="booking_count_change_percentage" type="NUMERIC(10,2)"/>
            <column name="snapshot" type="TEXT"><constraints nullable="false"/></column>
            <column name="generated_at" type="TIMESTAMP WITH TIME ZONE"><constraints nullable="false"/></column>
        </createTable>
        <addUniqueConstraint tableName="periodic_reports" constraintName="uk_periodic_reports_owner_period"
                             columnNames="owner_id, period_type, period_start, period_end"/>
        <createIndex tableName="periodic_reports" indexName="idx_periodic_reports_owner_end">
            <column name="owner_id"/>
            <column name="period_end"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
